prefix=${pcfiledir}/@FF_PC_PREFIX@
exec_prefix=${prefix}
libdir=${pcfiledir}/..
includedir=${pcfiledir}/@FF_PC_INCLUDEDIR@

Name: ff
Description: Compact, embeddable Forth interpreter
URL: https://github.com/mikhailborisov/ff
Version: @PROJECT_VERSION@
Libs: -L${libdir} @FF_PC_LIBS@
@FF_PC_LIBS_PRIVATE@
Cflags: -I${includedir}/ff -I${includedir}
